# Hakim API configuration

# HTTP port for the API server
PORT=4000

# development | production
NODE_ENV=development

# Allowed browser origin (the React client)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/hakim

# Redis connection string (caching, rate limiting, booking locks)
REDIS_URL=redis://127.0.0.1:6379

# JWT settings - use a long random value in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Booking rules
SLOT_MINUTES=30
MAX_BOOKING_DAYS_AHEAD=60

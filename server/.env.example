# Hakim API configuration. Copy this file to .env and adjust the values.

# Port the API listens on
PORT=4000

# development | production | test
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/hakim

# Redis connection string (optional: the API degrades gracefully without it)
REDIS_URL=redis://127.0.0.1:6379

# Secret used to sign JWT access tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (any value accepted by jsonwebtoken, e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Default lifetime in seconds for cached doctor queries
CACHE_TTL_SECONDS=60
